{
  "name": "hr-dashboard-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun run test:unit",
    "test:unit": "bun test",
    "test:integration": "bun test --conditions=react-server --config=./bunfig.integration.toml",
    "test:e2e": "bun tests/support/run-e2e.ts",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db/migrate.ts",
    "db:seed": "bun scripts/db/seed.ts",
    "system:provision-tenant": "bun scripts/system/provision-tenant.ts",
    "system:set-tenant-status": "bun scripts/system/set-tenant-status.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
