# Restricted application connection used for normal runtime database queries.
DATABASE_URL=postgres://hr_app:dev_runtime_password@127.0.0.1:54329/hr_dashboard
# Privileged schema-owner connection used by migrations and administrative scripts.
MIGRATION_DATABASE_URL=postgres://hr_migrator:dev_migrator_password@127.0.0.1:54329/hr_dashboard
# Privileged connection used to create and clean up integration-test fixtures.
TEST_ADMIN_DATABASE_URL=postgres://hr_migrator:dev_migrator_password@127.0.0.1:54330/hr_dashboard_integration_test
# Restricted application connection used to verify integration-test permissions and RLS.
TEST_DATABASE_URL=postgres://hr_app:dev_runtime_password@127.0.0.1:54330/hr_dashboard_integration_test
# Random secret (at least 32 characters) used to sign and secure authentication data.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public base URL Better Auth uses for callbacks and trusted-origin checks.
BETTER_AUTH_URL=http://localhost:3000
# One-time secret required to create the first tenant and owner through /setup.
TENANT_BOOTSTRAP_SECRET=replace-with-a-one-time-bootstrap-secret
# Base64-encoded 32-byte key used to encrypt sensitive legal identifiers at rest.
LEGAL_IDENTIFIER_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Base64-encoded 32-byte key Next.js uses to encrypt Server Action payloads.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
